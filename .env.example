# Copy to .env. Only the variables for the source you use are needed.

# --- core ---
SOURCE=local                      # local | mediawiki | suitecrm | gitlab
DOCS_PATH=./demo/corpus           # for SOURCE=local
STORAGE_DIR=./storage             # persisted FAISS index and chunk store
EMBED_MODEL=BAAI/bge-small-en-v1.5   # any sentence-transformers model, or "hashing" (no download)
LLM_BACKEND=auto                  # auto | ollama | extractive
OLLAMA_MODEL=llama3.1:8b
OLLAMA_URL=http://localhost:11434
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=50
TOP_K=6
MODEL_ID=onprem-rag               # model id reported on /v1/models
ASSISTANT_DOMAIN=the organisation's internal documentation
CITE_SOURCES=true
SLACK_WEBHOOK_URL=                # optional update notifications
LOG_LEVEL=INFO

# --- mediawiki ---
MEDIAWIKI_API_URL=https://wiki.example.org/api.php
MEDIAWIKI_NAMESPACES=0,14
MEDIAWIKI_SKIP_OBSOLETE=true
MEDIAWIKI_VERIFY_SSL=true
BLACKLIST_FILE=blacklist.txt

# --- suitecrm (REST v4.1) ---
SUITECRM_API_URL=https://crm.example.org/service/v4_1/rest.php
SUITECRM_USER=
SUITECRM_PASSWORD=
SUITECRM_ENTITIES=examples/suitecrm_entities.json
SUITECRM_VERIFY_SSL=true

# --- gitlab ---
GITLAB_URL=https://gitlab.example.org
GITLAB_TOKEN=
GITLAB_PROJECT_IDS=               # comma separated; empty = every accessible project
MAX_PROJECTS=50
INDEX_ISSUES=true
INDEX_README=true
INDEX_DOCS=true
GITLAB_VERIFY_SSL=true
